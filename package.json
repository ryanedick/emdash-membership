{
  "name": "emdash-memberships",
  "version": "0.4.1",
  "description": "Member accounts for EmDash sites: magic-link sign-in, plans and entitlements, Stripe subscriptions with trials, coupons and revenue reporting, lifecycle emails, comp time, and a Members area in the EmDash admin. Runs on Cloudflare D1.",
  "keywords": [
    "emdash",
    "emdash-plugin",
    "astro",
    "cloudflare",
    "d1",
    "memberships",
    "magic-link",
    "paywall",
    "stripe",
    "subscriptions"
  ],
  "license": "MIT",
  "author": "Ryan Edick",
  "homepage": "https://github.com/ryanedick/emdash-membership#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryanedick/emdash-membership.git"
  },
  "bugs": {
    "url": "https://github.com/ryanedick/emdash-membership/issues"
  },
  "type": "module",
  "sideEffects": [
    "./components/*.astro"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "default": "./dist/stripe.js"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "default": "./dist/plugin/index.js"
    },
    "./plugin/runtime": {
      "types": "./dist/plugin/runtime.d.ts",
      "default": "./dist/plugin/runtime.js"
    },
    "./components/Paywall.astro": "./components/Paywall.astro",
    "./components/PricingTable.astro": "./components/PricingTable.astro",
    "./components/MemberAccount.astro": "./components/MemberAccount.astro",
    "./components/CancelFlow.astro": "./components/CancelFlow.astro",
    "./components/GiftForm.astro": "./components/GiftForm.astro",
    "./components/TeamManager.astro": "./components/TeamManager.astro",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "components",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"test/*.test.ts\"",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "astro": ">=5.0.0",
    "stripe": ">=18.0.0",
    "emdash": ">=1.3.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    },
    "stripe": {
      "optional": true
    },
    "emdash": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "astro": "^7.3.2",
    "stripe": "^23.0.0",
    "typescript": "^6.0.3",
    "emdash": "^1.4.0",
    "zod": "^4.5.4"
  }
}
